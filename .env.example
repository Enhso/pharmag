# Copy to .env and fill in. Write values with no quotes and no spaces around them:
# `docker run --env-file` passes quote characters through, and the config check rejects them.
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://llm-proxy.example/v1
OPENAI_MODEL=replace-with-chat-model-name
OPENAI_EMBEDDING_MODEL=replace-with-embedding-model-name

# Optional. Each role uses OPENAI_MODEL when its line stays commented out.
# PHARMAG_PLANNER_MODEL=
# PHARMAG_WORKER_MODEL=
# PHARMAG_WRITER_MODEL=
# PHARMAG_CRITIC_MODEL=
